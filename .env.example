# Пример настроек одной установки. Скопируйте в .env (или укажите путь в ART_ENV_FILE).
SITE_THEME=a                 # a — МираМе, d — ХолСтори
SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=0
ALLOWED_HOSTS=mirame.ru,www.mirame.ru
CSRF_TRUSTED_ORIGINS=https://mirame.ru
ADMIN_PATH=admin
DATA_DIR=/srv/mirame/var     # база SQLite, медиатека, закрытые файлы
# DB_ENGINE=postgres
# DB_NAME=mirame
# DB_USER=mirame
# DB_PASSWORD=
# EMAIL_HOST=smtp.example.ru
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@mirame.ru
